<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.supsi.dti</groupId>
        <artifactId>blackjack</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>RELEASE</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <artifactId>backend</artifactId>

    <properties>
        <native.dir>${project.basedir}/src/main/c</native.dir>
        <output.dir>${project.build.directory}</output.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-h</arg>
                        <arg>${native.dir}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-native</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>gcc</executable>
                            <arguments>
                                <argument>-shared</argument>
                                <argument>${native.extra.cflag}</argument>
                                <argument>-o</argument>
                                <argument>${output.dir}/${native.lib.file}</argument>
                                <argument>${native.dir}/LicenseChecker.c</argument>
                                <argument>-I${env.JAVA_HOME}/include</argument>
                                <argument>-I${env.JAVA_HOME}/include/${native.jni.os.include}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <native.lib.file>licensechecker.dll</native.lib.file>
                <native.jni.os.include>win32</native.jni.os.include>
                <native.extra.cflag>-DWIN32</native.extra.cflag>
            </properties>
        </profile>
        <profile>
            <id>native-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <native.lib.file>liblicensechecker.dylib</native.lib.file>
                <native.jni.os.include>darwin</native.jni.os.include>
                <native.extra.cflag>-fPIC</native.extra.cflag>
            </properties>
        </profile>
        <profile>
            <id>native-linux</id>
            <activation><os><family>unix</family></os></activation>
            <properties>
                <native.lib.file>liblicensechecker.so</native.lib.file>
                <native.jni.os.include>linux</native.jni.os.include>
                <native.extra.cflag>-fPIC</native.extra.cflag>
            </properties>
        </profile>
    </profiles>
</project>