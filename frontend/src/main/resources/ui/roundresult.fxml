<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ch.supsi.dti.frontend.controller.RoundResultController"
           styleClass="root-pane"
           stylesheets="@menu.css, @game.css"
           prefWidth="1100" prefHeight="680">

    <VBox styleClass="card" spacing="0">

        <!-- ── Titlebar: round progress + save / menu icons ───── -->
        <HBox styleClass="card-titlebar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Label fx:id="titleLabel" text="" styleClass="titlebar-title"/>
            <HBox fx:id="progressDots" alignment="CENTER_LEFT" spacing="5"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="%roundresult.saved" styleClass="saved-pill"/>
            <Button text="💾" onAction="#onSaveClicked" styleClass="icon-button"/>
            <Button text="☰" onAction="#onBackToMenu" styleClass="icon-button"/>
        </HBox>

        <Region styleClass="divider"/>

        <!-- ── Session summary band ───────────────────────────── -->
        <HBox styleClass="session-band" alignment="CENTER" spacing="10">
            <padding><Insets top="8" right="14" bottom="8" left="14"/></padding>
            <Label fx:id="sessionLabel" text="" styleClass="session-line"/>
        </HBox>

        <Region styleClass="divider"/>

        <!-- ── Body: 3 columns ────────────────────────────────── -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <!-- ── Left: dealer hand ─────────────────────────── -->
            <VBox prefWidth="300" minWidth="300" spacing="10" HBox.hgrow="ALWAYS">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>

                <Label text="%roundresult.dealerHand" styleClass="field-label"/>

                <HBox fx:id="dealerCardsBox" alignment="CENTER" spacing="6" minHeight="140"/>

                <HBox alignment="CENTER">
                    <Label fx:id="dealerScorePill" text="" styleClass="dealer-score-pill"/>
                </HBox>

                <Region prefHeight="12"/>

                <Label fx:id="dealerHistoryHeader" text="%roundresult.dealer.history"
                       styleClass="field-label"/>
                <FlowPane fx:id="dealerHistoryList" styleClass="dealer-history-grid"
                          hgap="6" vgap="6" prefWrapLength="260"/>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Centre: dealer banner + chart + heroes + others ── -->
            <VBox HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_CENTER"
                  maxWidth="760">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <!-- Dealer outcome banner ("Banco sballato a 25", etc.) -->
                <Label fx:id="dealerBanner" text="" styleClass="dealer-banner"
                       alignment="CENTER" maxWidth="Infinity"/>

                <!-- Round meta: "Round 1/10 · puntata totale al tavolo $60" -->
                <Label fx:id="roundMetaLabel" text="" styleClass="round-meta"/>

                <!-- Per-player balance evolution chart (line per player across rounds).
                     Populated programmatically in the controller — easier than wiring
                     NumberAxis instances through FXML. -->
                <StackPane fx:id="chartContainer" minHeight="220" prefHeight="240"
                           styleClass="chart-container" VBox.vgrow="ALWAYS"/>

                <!-- Hero block(s) — one per human player, built dynamically. -->
                <VBox fx:id="heroBox" alignment="CENTER" spacing="12"/>

                <Region prefHeight="6"/>

                <Label fx:id="othersHeader" text="%roundresult.others" styleClass="field-label"/>
                <VBox fx:id="othersList" spacing="6"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="primaryActionBtn" text="%roundresult.action.newRound"
                        onAction="#onNewRound" styleClass="primary-button"
                        maxWidth="Infinity"/>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Right: updated balances ───────────────────── -->
            <VBox prefWidth="260" minWidth="260" spacing="10" HBox.hgrow="ALWAYS">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>

                <Label text="%roundresult.balancesUpdated" styleClass="field-label"/>

                <VBox fx:id="balancesList" spacing="0"/>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

        </HBox>

    </VBox>

</StackPane>
