<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ch.supsi.dti.frontend.controller.RoundResultController"
           styleClass="root-pane"
           stylesheets="@menu.css, @game.css"
           prefWidth="1100" prefHeight="680">

    <VBox styleClass="card" maxWidth="1000" maxHeight="600" spacing="0">

        <!-- ── Titlebar ───────────────────────────────────────── -->
        <HBox styleClass="card-titlebar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="titleLabel" text="" styleClass="titlebar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="%roundresult.saved" styleClass="license-pill, license-pill-title"/>
        </HBox>

        <Region styleClass="divider"/>

        <!-- ── Body: 3 columns ────────────────────────────────── -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <!-- ── Left: dealer hand + balances ───────────────── -->
            <VBox prefWidth="280" minWidth="280" spacing="10">
                <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>

                <Label text="%roundresult.dealerHand" styleClass="field-label"/>

                <HBox fx:id="dealerCardsBox" alignment="CENTER" spacing="6" minHeight="100"/>

                <HBox alignment="CENTER">
                    <Label text="18" styleClass="dealer-score-pill"/>
                </HBox>

                <Region prefHeight="14"/>

                <Label text="%roundresult.balancesUpdated" styleClass="field-label"/>

                <HBox styleClass="balance-mini-row" alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="seat-avatar"><Label text="A" styleClass="seat-avatar-initial"/></StackPane>
                    <Label text="Alice" styleClass="balance-mini-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="\$1.300" styleClass="balance-mini-value"/>
                    <Label text="+" styleClass="delta-pos"/>
                </HBox>

                <HBox styleClass="balance-mini-row" alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="seat-avatar, seat-avatar-bob"><Label text="B" styleClass="seat-avatar-initial"/></StackPane>
                    <Label text="Bob" styleClass="balance-mini-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="\$1.000" styleClass="balance-mini-value"/>
                </HBox>

                <HBox styleClass="balance-mini-row" alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="seat-avatar, seat-avatar-cpu"><Label text="C" styleClass="seat-avatar-initial"/></StackPane>
                    <Label text="Carlos" styleClass="balance-mini-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="\$780" styleClass="balance-mini-value"/>
                </HBox>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Center: winner + outcomes + actions ────────── -->
            <VBox HBox.hgrow="ALWAYS" spacing="12" alignment="TOP_CENTER">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <StackPane styleClass="winner-circle">
                    <Label text="🏆" styleClass="winner-icon"/>
                </StackPane>

                <Label fx:id="winnerLabel" text="" styleClass="winner-title"/>
                <Label text="Blackjack · +\$150" styleClass="winner-subtitle"/>

                <HBox styleClass="streak-banner" alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="streakLabel" text="" styleClass="streak-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="+\$0 XP" styleClass="delta-pos"/>
                </HBox>

                <VBox spacing="6">
                    <HBox styleClass="outcome-row" alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="seat-avatar"><Label text="A" styleClass="seat-avatar-initial"/></StackPane>
                        <Label text="Alice 21" styleClass="outcome-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="%roundresult.outcome.win" styleClass="outcome-chip, outcome-chip-win"/>
                        <Label text="+\$150" styleClass="delta-pos"/>
                    </HBox>

                    <HBox styleClass="outcome-row" alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="seat-avatar, seat-avatar-bob"><Label text="B" styleClass="seat-avatar-initial"/></StackPane>
                        <Label text="Bob 17" styleClass="outcome-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="%roundresult.outcome.push" styleClass="outcome-chip, outcome-chip-push"/>
                        <Label text="-\$25" styleClass="delta-neg"/>
                    </HBox>

                    <HBox styleClass="outcome-row" alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="seat-avatar, seat-avatar-cpu"><Label text="C" styleClass="seat-avatar-initial"/></StackPane>
                        <Label text="Carlos 20" styleClass="outcome-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="%roundresult.outcome.lose" styleClass="outcome-chip, outcome-chip-loss"/>
                        <Label text="-\$100" styleClass="delta-neg"/>
                    </HBox>

                    <HBox styleClass="outcome-row" alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="seat-avatar, seat-avatar-cpu"><Label text="C" styleClass="seat-avatar-initial"/></StackPane>
                        <Label text="CPU 18" styleClass="outcome-name" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="%roundresult.outcome.push" styleClass="outcome-chip, outcome-chip-push"/>
                        <Label text="+\$0" styleClass="balance-mini-value"/>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10">
                    <Button text="%roundresult.action.newRound" onAction="#onNewRound"
                            styleClass="primary-button"/>
                    <Button fx:id="saveGameButton" text="%roundresult.action.saveGame" onAction="#onSaveGame"
                            styleClass="secondary-button"/>
                    <Button text="%roundresult.action.menu" onAction="#onBackToMenu"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Right: next bet + autosave ─────────────────── -->
            <VBox prefWidth="240" minWidth="240" spacing="14">
                <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>

                <Label text="%roundresult.nextBet" styleClass="field-label"/>
                <Label text="\$50" styleClass="next-bet-value"/>

                <HBox spacing="10">
                    <Button text="%roundresult.change" styleClass="secondary-button"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="%roundresult.keep" styleClass="primary-button"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Region prefHeight="20"/>

                <VBox styleClass="autosave-pill" alignment="CENTER" spacing="6">
                    <Label text="💾" styleClass="autosave-icon"/>
                    <Label text="%roundresult.autosave" styleClass="autosave-text"/>
                </VBox>
            </VBox>

        </HBox>

    </VBox>

</StackPane>
