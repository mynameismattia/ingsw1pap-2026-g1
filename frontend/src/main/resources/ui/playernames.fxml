<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ch.supsi.dti.frontend.controller.PlayerNamesController"
           styleClass="root-pane"
           stylesheets="@menu.css"
           alignment="CENTER"
           prefWidth="1100" prefHeight="640">

    <VBox styleClass="card" minWidth="520" prefWidth="520" minHeight="380" spacing="0">

        <HBox styleClass="card-titlebar" alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Button text="%common.back" onAction="#onBack" styleClass="icon-button"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="%menu.names.title" styleClass="hero-title"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <Region styleClass="divider"/>

        <VBox spacing="14" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <Label text="%menu.names.header" styleClass="field-label"/>

            <VBox fx:id="nameFieldsBox" spacing="10" alignment="CENTER"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="%mainmenu.action.start" onAction="#onConfirm"
                    styleClass="primary-button" maxWidth="Infinity"/>
        </VBox>

    </VBox>

</StackPane>
