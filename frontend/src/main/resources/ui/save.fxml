<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Layout del dialog Salva partita.
  Card centrale con 3 slot, ciascuno con info di salvataggio (round, balance, timestamp) e bottone Salva.
-->

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ch.supsi.dti.frontend.controller.SaveGameController"
           styleClass="root-pane"
           stylesheets="@menu.css"
           alignment="CENTER"
           prefWidth="1100" prefHeight="640">

    <VBox styleClass="card" minWidth="640" prefWidth="760" minHeight="420" spacing="0">

        <HBox styleClass="card-titlebar" alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Button text="%common.back" onAction="#onBack" styleClass="icon-button"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="%save.dialog.title" styleClass="hero-title"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <Region styleClass="divider"/>

        <VBox fx:id="slotsContainer" styleClass="controls-pane" spacing="14" VBox.vgrow="ALWAYS">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        </VBox>

    </VBox>

    <StackPane fx:id="confirmOverlay" styleClass="overlay-backdrop"
               visible="false" managed="false" onMouseClicked="#onConfirmBackdropClicked">
        <VBox styleClass="overlay-card" spacing="14"
              maxWidth="420" maxHeight="-Infinity" alignment="CENTER">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <Label fx:id="confirmBody" text="" styleClass="dialog-header"
                   wrapText="true" maxWidth="360"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="confirmCancel" text="%common.cancel" styleClass="secondary-button"/>
                <Button fx:id="confirmOk" text="%common.confirm" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
