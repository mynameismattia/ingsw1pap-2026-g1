<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ch.supsi.dti.frontend.controller.GameController"
           styleClass="root-pane"
           stylesheets="@menu.css, @game.css"
           prefWidth="1100" prefHeight="680">

    <VBox styleClass="card" maxWidth="1040" maxHeight="620" spacing="0">

        <!-- ── Titlebar ───────────────────────────────────────── -->
        <HBox styleClass="card-titlebar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Button text="%game.titlebar.menu" onAction="#onBackToMenuClicked" styleClass="icon-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="roundLabel" text="" styleClass="round-pill"/>
            <Label fx:id="deckLabel"  text="" styleClass="deck-pill"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⚙" onAction="#onSettingsClicked" styleClass="icon-button"/>
        </HBox>

        <Region styleClass="divider"/>

        <!-- ── Body: 3 columns ────────────────────────────────── -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">

            <!-- ── Left column: players list + bottom actions ── -->
            <VBox prefWidth="200" minWidth="200" spacing="10">
                <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>

                <Label text="%game.panel.players" styleClass="field-label"/>

                <!-- Players list populated dynamically by the controller -->
                <VBox fx:id="sidePlayersList" spacing="8"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="historyButton" text="%game.button.history" onAction="#onHistoryClicked"
                        styleClass="secondary-button" maxWidth="Infinity"/>
                <Button text="%game.action.pause" onAction="#onPauseClicked"
                        styleClass="secondary-button" maxWidth="Infinity"/>
                <Button text="%game.action.quit" onAction="#onQuitClicked"
                        styleClass="danger-button" maxWidth="Infinity"/>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Center column: green table ─────────────────── -->
            <VBox HBox.hgrow="ALWAYS" styleClass="table-felt" spacing="10">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                <!-- Dealer section -->
                <Label text="%game.dealer" styleClass="seat-card-name" alignment="CENTER" maxWidth="Infinity"/>
                <HBox fx:id="dealerCardsBox" alignment="CENTER" spacing="6" minHeight="100"/>
                <HBox alignment="CENTER">
                    <Label fx:id="dealerScoreLabel" text="" styleClass="dealer-score-pill"/>
                </HBox>

                <!-- Decorative table oval -->
                <Region VBox.vgrow="ALWAYS" styleClass="table-oval" maxWidth="Infinity"/>

                <!-- Player seats row -->
                <HBox fx:id="playersRow" alignment="CENTER" spacing="20"/>

                <!-- Status message + sequential betting prompt -->
                <Label fx:id="messageLabel" text="" styleClass="message-banner"
                       alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="bettingPromptLabel" text="" styleClass="betting-prompt"
                       alignment="CENTER" maxWidth="Infinity"/>

                <!-- Action bar -->
                <HBox styleClass="action-bar" alignment="CENTER" spacing="8">
                    <Button fx:id="hitButton"    text="%game.button.hit"    onAction="#onHitClicked"    styleClass="action-button"/>
                    <Button fx:id="standButton"  text="%game.button.stand"  onAction="#onStandClicked"  styleClass="action-button"/>
                    <Button fx:id="doubleButton" text="%game.button.double" onAction="#onDoubleClicked" styleClass="action-button"/>
                    <Button fx:id="splitButton"  text="%game.button.split"  onAction="#onSplitClicked"  styleClass="action-button"/>
                    <Button fx:id="insureButton" text="%game.button.insure" onAction="#onInsureClicked" styleClass="action-button"/>
                    <Button fx:id="declineInsuranceButton" text="%game.button.declineInsurance"
                            onAction="#onDeclineInsuranceClicked" styleClass="action-button"/>
                    <Button fx:id="viewResultsButton" text="%game.action.viewResults"
                            onAction="#onViewResultsClicked" styleClass="primary-button"/>
                </HBox>
            </VBox>

            <Region styleClass="vdivider"/>

            <!-- ── Right column: bet + chips ──────────────────── -->
            <VBox prefWidth="240" minWidth="240" spacing="12">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <Label text="%game.panel.bet" styleClass="field-label"/>

                <!-- Chips: 3x2 grid -->
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="chip5"   text="\$5"   onAction="#onChipClicked"
                            styleClass="chip-button, chip-5" userData="5"/>
                    <Button fx:id="chip10"  text="\$10"  onAction="#onChipClicked"
                            styleClass="chip-button, chip-10" userData="10"/>
                    <Button fx:id="chip25"  text="\$25"  onAction="#onChipClicked"
                            styleClass="chip-button, chip-25" userData="25"/>
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="chip50"  text="\$50"  onAction="#onChipClicked"
                            styleClass="chip-button, chip-50" userData="50"/>
                    <Button fx:id="chip100" text="\$100" onAction="#onChipClicked"
                            styleClass="chip-button, chip-100" userData="100"/>
                    <Button fx:id="chip250" text="\$250" onAction="#onChipClicked"
                            styleClass="chip-button, chip-250" userData="250"/>
                </HBox>

                <!-- Current bet card -->
                <VBox styleClass="current-bet-card" spacing="6">
                    <Label text="%game.panel.current" styleClass="field-label"/>
                    <Label fx:id="currentBetLabel" text="\$0" styleClass="current-bet-value"/>
                    <Button text="%game.panel.clear" onAction="#onClearBet"
                            styleClass="secondary-button" maxWidth="Infinity"/>
                </VBox>

                <Button fx:id="dealButton" text="%game.button.deal" onAction="#onDealClicked"
                        styleClass="primary-button" maxWidth="Infinity"/>

                <Label text="%game.panel.lastRounds" styleClass="field-label"/>

                <HBox styleClass="mini-round-row" alignment="CENTER_LEFT">
                    <Label text="Round 2" styleClass="mini-round-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="+\$75" styleClass="delta-pos"/>
                </HBox>
                <HBox styleClass="mini-round-row" alignment="CENTER_LEFT">
                    <Label text="Round 1" styleClass="mini-round-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="-\$25" styleClass="delta-neg"/>
                </HBox>
            </VBox>

        </HBox>

    </VBox>

</StackPane>
